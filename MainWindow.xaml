<Window x:Class="FipGoldBucharest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FIP Gold Bucharest 2026"
        Icon="app.ico"
        Width="1040"
        Height="800"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}">
    <Grid Margin="18,12,18,18" Background="{StaticResource BgBrush}">
        <TabControl x:Name="MainTabs">

            <!-- ============================ TAB 1: HOME ============================ -->
            <TabItem Header="🏠 Home">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,20,0">
                                <Ellipse x:Name="DotScoreboardHome" Width="12" Height="12" Fill="{StaticResource WarningBrush}" Margin="0,2,10,0"/>
                                <TextBlock x:Name="TxtScoreboardStatusHome" Text="Starting..." FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Referee remote URL (open on the phone, same Wi-Fi network)" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                <TextBox x:Name="TxtMobileUrlHome" IsReadOnly="True" Margin="0,4,0,0" Text="http://127.0.0.1:8080/mobile"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Padding="14,8" Margin="10,0,0,0" Click="BtnCopyMobileUrlHome_Click">Copy</Button>

                            <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="3" Content="Minimize to tray" VerticalAlignment="Center" Margin="18,0,4,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="HomeWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="HomePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎾" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtHomePlaceholder" Text="Starting score server..." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= TAB 2: SCORE SETTINGS ======================= -->
            <TabItem Header="🎾 Score settings">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Scoreboard server control bar -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                                    <TextBlock Text="SCORE SERVER" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse x:Name="DotScoreboard" Width="12" Height="12" Fill="{StaticResource WarningBrush}" Margin="0,4,10,0"/>
                                        <TextBlock x:Name="TxtScoreboardStatus" Text="Stopped" FontSize="17" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="BtnScoreboardStartStop" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnScoreboardStartStop_Click" Margin="0,0,14,0" MinWidth="110">
                                    Start
                                </Button>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Port" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBox x:Name="TxtScoreboardPort" Width="70" Margin="0,4,0,0" TextChanged="Settings_Changed"/>
                                </StackPanel>

                                <CheckBox x:Name="ChkScoreboardAutoStart" Grid.Column="4" Content="Auto start" VerticalAlignment="Center" Margin="0,0,14,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>

                                <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,0,10,0" Click="BtnOpenAdminBrowser_Click">Open in browser</Button>
                                <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnScoreboardReload_Click">⟳</Button>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="OBS overlay URL (add as Browser Source, 1920x1080)" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtOverlayUrl" IsReadOnly="True" Text="http://127.0.0.1:8080/overlay"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="BtnCopyOverlayUrl_Click">Copy</Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Referee remote URL (score + serve, open on the phone)" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtMobileUrl" IsReadOnly="True" Text="http://127.0.0.1:8080/mobile"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0" Click="BtnCopyMobileUrl_Click">Copy</Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Embedded admin panel -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="ScoreboardWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="ScoreboardPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎾" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtScoreboardPlaceholder" Text="Scoreboard server is not running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ TAB 3: MEDIA =========================== -->
            <TabItem Header="🎬 Media">
                <Grid Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="MediaWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="MediaPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtMediaPlaceholder" Text="Media controls load when the score server is running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ TAB 4: TEAMS =========================== -->
            <TabItem Header="👥 Teams">
                <Grid Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="TeamsWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="TeamsPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="👥" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtTeamsPlaceholder" Text="Teams list loads when the score server is running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
