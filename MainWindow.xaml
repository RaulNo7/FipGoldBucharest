<Window x:Class="FipGoldBucharest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FIP Gold Bucharest 2026"
        Icon="app.ico"
        Width="1040"
        Height="800"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}">
    <Grid Margin="18,12,18,18" Background="{StaticResource BgBrush}">
        <TabControl x:Name="MainTabs">

            <!-- ============================ TAB 1: HOME ============================ -->
            <TabItem Header="🏠 Home">
                <Grid Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="HomeWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="HomePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎾" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtHomePlaceholder" Text="Starting score server..." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= TAB 2: SCORE SETTINGS ======================= -->
            <TabItem Header="🎾 Score settings">
                <Grid Margin="0,14,0,0">
                    <!-- Embedded score-settings page -->
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="ScoreboardWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="ScoreboardPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎾" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtScoreboardPlaceholder" Text="Scoreboard server is not running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ TAB 3: MEDIA =========================== -->
            <TabItem Header="🎬 Media">
                <Grid Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="MediaWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="MediaPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtMediaPlaceholder" Text="Media controls load when the score server is running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ TAB 4: TEAMS =========================== -->
            <TabItem Header="👥 Teams">
                <Grid Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="TeamsWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="TeamsPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="👥" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtTeamsPlaceholder" Text="Teams list loads when the score server is running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ TAB 5: ADMIN =========================== -->
            <TabItem Header="⚙ Admin">
                <Grid Margin="0,14,0,0">
                    <!-- Embedded admin page (OBS overlay URL, Court TV, YouTube link, internet access,
                         and the Score server card, which drives this window through the WebView2 bridge).
                         While the server is down the page cannot load, so the placeholder keeps a Start row. -->
                    <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                        <Grid>
                            <wv2:WebView2 x:Name="SettingsWebView" Visibility="Collapsed"/>
                            <StackPanel x:Name="SettingsPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="48" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtSettingsPlaceholder" Text="Admin settings load when the score server is running." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,10,0,0" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Ellipse x:Name="DotScoreboard" Width="12" Height="12" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScoreboardStatus" Text="Stopped" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                    <TextBlock Text="Port" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtScoreboardPort" Width="80" VerticalAlignment="Center" Margin="0,0,14,0" TextChanged="Settings_Changed"/>
                                    <Button x:Name="BtnScoreboardStartStop" Style="{StaticResource SecondaryButton}" MinWidth="140" Click="BtnScoreboardStartStop_Click">Start server</Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
